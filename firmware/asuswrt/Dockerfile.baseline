FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends \
    build-essential asciidoc binutils bison bzip2 gawk gettext git \
    libncurses5-dev libz-dev patch python python2.7 python3 unzip zlib1g-dev \
    lib32gcc1 libc6-dev-i386 subversion flex uglifyjs gcc-multilib \
    p7zip p7zip-full msmtp libssl-dev texinfo libglib2.0-dev xmlto \
    qemu-utils upx-ucl libelf-dev autoconf automake libtool autopoint \
    device-tree-compiler g++-multilib antlr3 gperf wget \
    libncurses5:i386 libelf1:i386 lib32z1 lib32stdc++6 \
    gtk-doc-tools intltool binutils-dev cmake lzma liblzma-dev lzma-dev \
    uuid-dev liblzo2-dev xsltproc dos2unix libstdc++5 docbook-xsl docbook-xsl-ns \
    sharutils autogen shtool gengetopt libltdl-dev libtool-bin \
    pkg-config libsysfs-dev ca-certificates file rsync cpio bc sudo \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /bin/bash /bin/sh \
    && useradd --uid 1000 --create-home --shell /bin/bash builder

RUN apt-get update && apt-get install -y --no-install-recommends qemu-user xxd \
    && rm -rf /var/lib/apt/lists/*

USER builder
WORKDIR /workspace/source/asuswrt/release/src-rt-5.02axhnd.675x
