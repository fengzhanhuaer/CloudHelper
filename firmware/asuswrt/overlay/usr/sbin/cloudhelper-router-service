#!/bin/sh
# No logfile and no syslog: native console receives stdout/stderr.
pidfile=/var/run/cloudhelper-router/admin.sock.pid
stopped=/var/run/cloudhelper-router.stopped
owned_pid() {
  test -r "$pidfile" || return 1
  pid=$(cat "$pidfile")
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  test "$(readlink "/proc/$pid/exe")" = /usr/sbin/cloudhelper-router-plugin
}
umask 077
case "$1" in
 start|ensure)
   if test "$1" = ensure && test -e "$stopped"; then exit 0; fi
   if test "$1" = start; then rm -f "$stopped"; fi
   if owned_pid; then exit 0; fi
   test -d /jffs || exit 1
   mkdir -p /jffs/cloudhelper-router /var/run/cloudhelper-router || exit 1
   chmod 700 /jffs/cloudhelper-router /var/run/cloudhelper-router || exit 1
   /usr/sbin/cloudhelper-router-plugin </dev/null >/dev/console 2>&1 &
   count=0
   while ! owned_pid && test "$count" -lt 5; do sleep 1; count=$((count+1)); done
   owned_pid || exit 1
   ;;
 stop)
   : > "$stopped"
   if owned_pid; then
     kill -TERM "$pid"
     count=0
     while owned_pid && test "$count" -lt 60; do sleep 1; count=$((count+1)); done
     if owned_pid; then kill -KILL "$pid"; sleep 1; fi
   fi
   rm -f "$pidfile"
   /usr/sbin/cloudhelper-router-plugin --cleanup </dev/null >/dev/console 2>&1
   ;;
 *) echo 'usage: cloudhelper-router-service start|stop|ensure' >&2; exit 2;;
esac
