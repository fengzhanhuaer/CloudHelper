<!DOCTYPE html>
<html><head><base href="/"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>虚拟路由</title><link rel="stylesheet" href="/index_style.css"><link rel="stylesheet" href="/form_style.css">
<script src="/state.js"></script><script src="/general.js"></script><script src="/popup.js"></script><script src="/help.js"></script><script src="/js/jquery.js"></script>
<style>
.vr{padding:22px;color:#fff;max-width:900px}.vr h2{color:#00ddd0}.vr section{background:#3c4b50;padding:18px;margin:16px 0;border-radius:6px}.vr label{display:flex;align-items:center;gap:15px;margin:12px 0}.vr label span{width:180px;flex-shrink:0}.vr input[type=text],.vr input[type=password],.vr input[type=number],.vr select{box-sizing:border-box;background:#26363c;border:1px solid #71848a;color:#fff;padding:8px;width:340px;max-width:100%}.vr textarea{box-sizing:border-box;width:100%;min-height:100px;background:#26363c;border:1px solid #71848a;color:#fff;padding:8px}.vr .tabs{display:flex;gap:8px}.vr .tabs button[aria-selected=true]{background:#00a79b}.vr button{padding:9px 18px;border:0;border-radius:4px;background:#168b89;color:#fff;cursor:pointer}.vr button:disabled{opacity:.5;cursor:wait}.vr .hint{color:#bdced1;font-size:12px;line-height:1.7}.vr table{width:100%;border-collapse:collapse;font-size:13px}.vr td,.vr th{padding:9px 6px;text-align:left;border-bottom:1px solid #64777e}.vr .scroll{overflow-x:auto}.vr .error{color:#ffcf9d;white-space:pre-wrap}.vr .status{line-height:1.8}.vr .actions{display:flex;gap:8px;flex-wrap:wrap}.menu_VirtualRouter{background-position:0 -812px!important}@media(max-width:700px){.vr label{display:block}.vr label span{display:block;margin-bottom:6px}.vr{padding:12px}}
.vr .upstream{display:flex;align-items:center;gap:15px;margin:12px 0}.vr label.upstream-toggle{width:180px;flex-shrink:0;margin:0;gap:8px}.vr .upstream input:disabled{opacity:.5}@media(max-width:700px){.vr .upstream{display:block}.vr label.upstream-toggle{display:flex;margin-bottom:6px}}
</style></head><body onload="initVR()"><div id="TopBanner"></div><div id="Loading" class="popup_bg"></div><div id="hiddenMask" class="popup_bg"><table><tr><td><div id="loadingBlock"></div></td></tr></table></div>
<table class="content" align="center" cellpadding="0" cellspacing="0"><tr><td width="17"></td><td valign="top" width="202"><div id="mainMenu"></div><div id="subMenu"></div></td><td valign="top"><div id="tabMenu" class="submenuBlock"></div><table width="98%" border="0" align="left" cellpadding="0" cellspacing="0"><tr><td align="left" valign="top"><table width="760px" border="0" cellpadding="5" cellspacing="0" class="FormTitle" id="FormTitle"><tr><td bgcolor="#4D595D" valign="top"><main class="vr"><h2>虚拟路由</h2>
<div class="tabs"><button id="routing_tab" onclick="tabVR(false)" aria-selected="true">虚拟路由</button><button id="gateway_tab" onclick="tabVR(true)" aria-selected="false">网关代理</button><button id="logs_tab" onclick="tabVR('logs')" aria-selected="false">日志</button></div><div id="notice" role="status" class="error"></div><div id="routing_panel"><section><h3>从主控导入</h3>
<p class="hint">在主控探针列表点击本节点的「安装」并复制配置，粘贴到这里自动填入连接设置。</p>
<textarea id="import_config" maxlength="8192" autocomplete="off" spellcheck="false" placeholder="粘贴主控复制的配置" onpaste="setTimeout(importVR,0)"></textarea>
<div class="actions"><button id="import_apply" onclick="importVR()">解析配置</button></div><div id="import_notice" class="hint" role="status"></div>
</section><section><h3>连接设置</h3>
<label><span>启用虚拟路由</span><input id="enabled" type="checkbox"></label>
<label><span>主控地址</span><input id="controller" type="text" placeholder="https://controller.example.com" autocomplete="off"></label>
<label><span>Node ID</span><input id="node_id" type="text" maxlength="128" autocomplete="off"></label>
<label><span>Node 密钥</span><input id="node_key" type="password" maxlength="1024" autocomplete="new-password" placeholder="填写节点密钥"></label>
<label><span>允许公网连接</span><input id="allow_wan" type="checkbox"></label>
<p class="hint">监听端口由主控统一配置。服务启用时始终监听 LAN 地址；允许公网连接后，额外监听 WAN 地址并放行端口。所有连接均需节点认证。</p>
<label><span>启用 DNS 分流</span><input id="dns_enabled" type="checkbox"></label>
<div class="upstream"><label class="upstream-toggle"><input id="doh_enabled" type="checkbox" checked onchange="upstreamVR()">启用 DoH</label><input id="dns_doh" type="text" aria-label="DoH 上游" value="https://dns.alidns.com/dns-query"></div>
<div class="upstream"><label class="upstream-toggle"><input id="dot_enabled" type="checkbox" checked onchange="upstreamVR()">启用 DoT</label><input id="dns_dot" type="text" aria-label="DoT 上游" value="dns.alidns.com:853"></div>
<div class="upstream"><label class="upstream-toggle"><input id="plain_dns_enabled" type="checkbox" checked onchange="upstreamVR()">启用普通 DNS</label><input id="dns_upstream" type="text" aria-label="普通 DNS 上游" value="223.5.5.5:53"></div>
<p class="hint">仅尝试已启用的上游，顺序为 DoH → DoT → 普通 DNS，最后回退系统 DNS。主控同步地址，本机保留开关选择。不能指向本路由器。</p>
<button id="save" onclick="saveVR()">保存并应用</button></section>
<section><h3>运行状态</h3><div id="status" class="status">正在读取…</div></section>
<section><h3>Probe Link</h3><div class="scroll"><table><thead><tr><th>对端</th><th>状态／域名</th><th>延迟</th><th>发送／接收速率</th><th>累计发送／接收</th></tr></thead><tbody id="links"></tbody></table></div></section>
<section><h3>节点测速</h3><label><span>目标 Probe Node</span><select id="target"></select></label><div class="actions"><button class="measure" onclick="measureVR('ping')">测延迟</button><button class="measure" onclick="measureVR('upload')">测上传</button><button class="measure" onclick="measureVR('download')">测下载</button></div><p class="hint">手动测速，一次一个任务。每方向最多 3 秒、16 MiB；仅显示本次结果。</p><div id="measurement" class="status"></div></section>
</div><div id="gateway_panel" style="display:none"><section><h3>网关代理</h3>
<label><span>允许远程访问 LAN</span><input id="gateway_enabled" type="checkbox"></label>
<label for="gateway_cidrs"><span>代理网段</span></label><textarea id="gateway_cidrs" placeholder="192.168.52.0/24&#10;192.168.60.0/24" spellcheck="false"></textarea>
<p class="hint">每行一个私有 IPv4 网段，最多32个。仅允许列表内的节点可访问，向 LAN 转发时执行 SNAT。</p>
<label><span>允许访问的节点</span><select id="gateway_candidate"></select><button onclick="addGatewayNode()">添加</button></label><div id="gateway_nodes" class="actions"></div>
<p class="hint">最多64个允许节点。配置保存在 JFFS；获准节点收到主控路由后会本地保存，重启恢复。</p>
<button id="gateway_save" onclick="saveGatewayVR()">保存并应用</button></section></div><div id="logs_panel" style="display:none"><section><h3>运行日志</h3><p class="hint">仅保留最近64条内存日志，不写文件；插件重启后清空。相同的连续错误合并显示。</p><button onclick="refreshLogsVR()">刷新日志</button><pre id="log_output" style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:360px;overflow:auto" aria-live="polite">暂无日志</pre></section></div></main></td></tr></table></td></tr></table></td></tr></table><div id="footer"></div>
<script>
current_url='user/cloudhelper-router/VirtualRouter.asp';
var csrf='',loaded=false,last={},lastAt=0,polling=false,gatewayNodes=[],gatewayCandidates=[],logActive=false,logPolling=false;
function el(id){return document.getElementById(id)}
function api(data,done){$.ajax({url:'/user/cloudhelper-router/api.asp',type:'POST',contentType:'application/json',data:JSON.stringify(data),dataType:'json',timeout:12000,success:function(r){if(!r.ok){el('notice').textContent=r.error||'操作失败';done&&done(null);return}done&&done(r)},error:function(){el('notice').textContent='无法连接管理服务，请确认登录状态';done&&done(null)}})}
function bytes(n){n=Number(n)||0;return n>=1048576?(n/1048576).toFixed(2)+' MiB':(n/1024).toFixed(1)+' KiB'}
function render(r){csrf=r.csrf;var c=r.config,s=r.status;if(!loaded){['controller','node_id'].forEach(function(k){el(k).value=c[k]||''});var d=c.dns_upstreams||{};el('dns_doh').value=d.doh||'';el('dns_dot').value=d.dot||'';el('dns_upstream').value=d.dns||'';el('doh_enabled').checked=d.doh_enabled!==false;el('dot_enabled').checked=d.dot_enabled!==false;el('plain_dns_enabled').checked=d.dns_enabled!==false;upstreamVR();['enabled','allow_wan','dns_enabled'].forEach(function(k){el(k).checked=!!c[k]});var g=c.gateway_proxy||{};el('gateway_enabled').checked=!!g.enabled;el('gateway_cidrs').value=(g.proxy_cidrs||[]).join('\n');gatewayNodes=(g.allowed_node_ids||[]).slice();renderGatewayNodes();el('node_key').placeholder=r.key_set?'已保存，留空保持原密钥':'填写节点密钥';loaded=true}
el('notice').textContent=s.error||'';el('status').textContent=(s.ready?'运行中':s.enabled?'连接中／未就绪':'已停用')+' · 主控 '+(s.controller_connected?'已连接':'未连接')+'\nLAN '+(s.lan||'—')+' · WAN '+(s.wan||'—')+' · 虚拟 IP '+(s.virtual_ip||'—')+' · 端口 '+(s.listen_port||'—')+' · 规则 '+(s.route_count||0)+' · 映射 '+(s.mappings||0);el('status').style.whiteSpace='pre-line';
var now=Date.now(),body=el('links');body.textContent='';(s.links||[]).forEach(function(l){var tr=document.createElement('tr'),old=last[l.route],seconds=(now-lastAt)/1000;var rates=old&&seconds>0?bytes(Math.max(0,l.tx_bytes-old.tx_bytes)/seconds)+'/s / '+bytes(Math.max(0,l.rx_bytes-old.rx_bytes)/seconds)+'/s':'—';[(s.nodes||[]).filter(function(n){return n.node_id===l.peer}).map(function(n){return n.display_name}).filter(function(n){return !!n})[0]||l.name||l.peer,l.state+' / '+(l.domain||'—')+(l.error?' · '+l.error:''),l.rtt_ms?l.rtt_ms.toFixed(1)+' ms':'—',rates,bytes(l.tx_bytes)+' / '+bytes(l.rx_bytes)].forEach(function(v){var td=document.createElement('td');td.textContent=v;tr.appendChild(td)});body.appendChild(tr);last[l.route]=l});lastAt=now;if(!body.children.length){var tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=5;td.textContent='暂无链路。请先配置主控并同步拓扑。';tr.appendChild(td);body.appendChild(tr)}
gatewayCandidates=s.nodes||[];var candidates=el('gateway_candidate'),chosen=candidates.value;candidates.textContent='';gatewayCandidates.filter(function(n){return n.node_id!==c.node_id}).forEach(function(n){var o=document.createElement('option');o.value=n.node_id;o.textContent=n.display_name||n.node_id;candidates.appendChild(o)});if(chosen)candidates.value=chosen;renderGatewayNodes();
var select=el('target'),selected=select.value;select.textContent='';(s.nodes||[]).filter(function(n){return n.node_id!==s.node_id}).forEach(function(n){var o=document.createElement('option');o.value=n.node_id;o.textContent=n.display_name||n.node_id;select.appendChild(o)});if(selected)select.value=selected;
var job=r.measurement||{},result=job.result||{};el('measurement').textContent=job.running?'正在测速…':job.error||result.error||(result.request_id?(job.kind==='ping'?'延迟 '+result.latency_ms+' ms':(result.mbps||0).toFixed(2)+' Mbps · '+bytes(result.bytes)+' · '+result.duration_ms+' ms'):'');Array.prototype.forEach.call(document.querySelectorAll('.measure'),function(b){b.disabled=!!job.running||!s.ready||!select.options.length})}
function refreshVR(){if(document.hidden||polling)return;polling=true;api({action:'status'},function(r){polling=false;if(r)render(r)});if(logActive)refreshLogsVR()}
function importVR(){
try{
if(!csrf)throw new Error('正在读取路由器配置，请稍后再解析');
var c;try{c=JSON.parse(el('import_config').value)}catch(parseError){throw new Error('配置不是有效的 JSON')}
if(!c||Array.isArray(c)||c.schema_version!==1||c.product!=='cloudhelper-asus56uv2')throw new Error('请粘贴主控提供的华硕配置');
if(typeof c.controller!=='string'||typeof c.node_id!=='string'||typeof c.node_key!=='string')throw new Error('配置缺少主控地址、Node ID 或节点密钥');
var address=c.controller.trim(),id=c.node_id.trim(),key=c.node_key.trim(),u=new URL(address);
if(u.protocol!=='https:'||!u.hostname||u.username||u.password||u.search||u.hash||address.length>512)throw new Error('主控地址必须为有效的 HTTPS 地址');
if(!/^[1-9][0-9]*$/.test(id)||id.length>128||!key||key.length>1024)throw new Error('Node ID 或节点密钥无效');
el('controller').value=address.replace(/\/+$/,'');el('node_id').value=id;el('node_key').value=key;loaded=true;
el('import_config').value='';el('import_notice').textContent='已填入连接设置，请确认后保存并应用。';
}catch(e){el('import_notice').textContent='导入失败：'+(e.message||'配置格式错误')}
}
function upstreamVR(){el('dns_doh').disabled=!el('doh_enabled').checked;el('dns_dot').disabled=!el('dot_enabled').checked;el('dns_upstream').disabled=!el('plain_dns_enabled').checked}
function saveVR(){el('save').disabled=true;api({action:'configure',csrf:csrf,config:{enabled:el('enabled').checked,controller:el('controller').value.trim(),node_id:el('node_id').value.trim(),node_key:el('node_key').value,allow_wan:el('allow_wan').checked,dns_enabled:el('dns_enabled').checked,dns_upstreams:{doh:el('dns_doh').value.trim(),dot:el('dns_dot').value.trim(),dns:el('dns_upstream').value.trim(),doh_enabled:el('doh_enabled').checked,dot_enabled:el('dot_enabled').checked,dns_enabled:el('plain_dns_enabled').checked}}},function(r){el('save').disabled=false;if(r){el('node_key').value='';loaded=false;refreshVR()}})}
function tabVR(tab){var gateway=tab===true;logActive=tab==='logs';el('gateway_panel').style.display=gateway?'':'none';el('routing_panel').style.display=!gateway&&!logActive?'':'none';el('logs_panel').style.display=logActive?'':'none';el('gateway_tab').setAttribute('aria-selected',gateway?'true':'false');el('routing_tab').setAttribute('aria-selected',!gateway&&!logActive?'true':'false');el('logs_tab').setAttribute('aria-selected',logActive?'true':'false');if(logActive)refreshLogsVR()}
function refreshLogsVR(){if(logPolling||document.hidden)return;logPolling=true;api({action:'logs'},function(r){logPolling=false;if(!r)return;el('log_output').textContent=(r.items||[]).map(function(v){return new Date(v.time*1000).toLocaleString()+' ['+v.component+'] '+v.message+(v.repeats>1?' （重复 '+v.repeats+' 次）':'')}).join('\n')||'暂无日志'})}
function renderGatewayNodes(){var list=el('gateway_nodes');list.textContent='';gatewayNodes.forEach(function(id){var b=document.createElement('button'),name=id;gatewayCandidates.forEach(function(n){if(n.node_id===id)name=n.display_name||id});b.textContent=name+' ×';b.onclick=function(){gatewayNodes=gatewayNodes.filter(function(v){return v!==id});renderGatewayNodes()};list.appendChild(b)})}
function addGatewayNode(){var id=el('gateway_candidate').value;if(id&&gatewayNodes.indexOf(id)<0)gatewayNodes.push(id);renderGatewayNodes()}
function saveGatewayVR(){el('gateway_save').disabled=true;api({action:'configure',csrf:csrf,config:{gateway_proxy:{enabled:el('gateway_enabled').checked,proxy_cidrs:el('gateway_cidrs').value.split(/[\s,;]+/).filter(function(v){return !!v}),allowed_node_ids:gatewayNodes}}},function(r){el('gateway_save').disabled=false;if(r){el('notice').textContent='网关代理配置已保存';loaded=false;refreshVR()}})}
function measureVR(kind){api({action:'measure',csrf:csrf,node:el('target').value,kind:kind},function(r){if(r)refreshVR()})}
function initVR(){if(typeof show_menu==='function')show_menu();refreshVR();setInterval(refreshVR,5000)}
</script></body></html>
